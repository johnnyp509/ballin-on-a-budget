{
  "name": "ballin-on-a-budget",
  "version": "1.0.0",
  "private": true,
  "description": "Ballin' on a Budget mobile app shell",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "assets:generate:native": "capacitor-assets generate --ios --android",
    "cap:sync": "npm run build:web && cap sync",
    "cap:sync:android": "npm run build:web && cap sync android",
    "cap:sync:ios": "npm run build:web && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "sharp": "^0.34.4"
  }
}
